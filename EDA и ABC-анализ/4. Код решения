).reset_index()

def perform_abc(df,index):
    cols = list(df.columns)
    cols.remove(index)
    grouped_df = df.groupby(index).agg({col: "sum" for col in cols})
    for col in cols:
        grouped_df[f'rel_{col}'] = grouped_df[col] / sum(grouped_df[col])
        grouped_df = grouped_df.sort_values(f'rel_{col}', ascending = False)
        grouped_df[f'cumsum_{col}'] = grouped_df[f'rel_{col}'].cumsum()
        grouped_df[f'abc_{col}'] = np.where(grouped_df[f'cumsum_{col}'] < 0.8, 'A', np.where(grouped_df[f'cumsum_{col}'] < 0.95, 'B', 'C'))
    abc_cols = [f'abc_{col}' for col in cols]
    grouped_df["abc_group"] = grouped_df[abc_cols].agg("".join, axis=1)
    return grouped_df[cols + abc_cols + ["abc_group"]].reset_index()


abc_res_df = perform_abc(abc_df, "level2").reset_index()

def abc_counts_plot(ax=None):
    if ax is None:
        fig, ax = plt.subplots(figsize=(10, 6))
    abc_counts = pd.concat([
        abc_res_df["abc_revenue"].value_counts().rename("Выручка"),
        abc_res_df["abc_gross_profit"].value_counts().rename("Валовая прибыль"),
        abc_res_df["abc_orders"].value_counts().rename("Количество заказов")
    ], axis=1).fillna(0)
    abc_counts = abc_counts.reindex(["A", "B", "C"]).fillna(0)
    abc_counts.plot(
        kind="bar",
        ax=ax,
        width=0.8
    )
    ax.set_title("Количество подкатегорий в ABC-группах")
    ax.set_xlabel("ABC-группа")
    ax.set_ylabel("Количество подкатегорий")
    ax.set_xticklabels(["A", "B", "C"], rotation=0)
    ax.legend(title="Показатель")
    return ax

abc_counts_plot()

