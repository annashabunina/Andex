def plot_top10(data, metric, title, xlabel, ax):
    top10 = (
        data.nlargest(10, metric)
        .sort_values(metric, ascending=True)
    )
    sns.barplot(
        data=top10,
        x=metric,
        y="level2",
        ax=ax
    )
    ax.set_title(title)
    ax.set_xlabel(xlabel)
    ax.set_ylabel("Подкатегория")
    return top10

